## A streamlined .gitignore for modern .NET projects
## including temporary files, build results, and
## files generated by popular .NET tools. If you are
## developing with Visual Studio, the VS .gitignore
## https://github.com/github/gitignore/blob/main/VisualStudio.gitignore
## has more thorough IDE-specific entries.
##
## Get latest from https://github.com/github/gitignore/blob/main/Dotnet.gitignore

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# .NET Core
project.lock.json
project.fragment.lock.json
artifacts/
GTK3VICE-*/
vice_VICII_tests/

# ASP.NET Scaffolding
ScaffoldingReadMe.txt

# NuGet Packages
*.nupkg
# NuGet Symbol Packages
*.snupkg

# dotenv environment variables file
.env

# Others
~$*
*~
CodeCoverage/
.vs/
*.user
*.suo

# NuGet package restore output
packages/

# Local ROMs and mounted media are required at runtime but not redistributed.
SNESEmulator/*.bin
*.sfc
*.smc
*.srm
*.snessav

# MSBuild Binary and Structured Log
*.binlog

# MSTest test Results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*

# NUnit
*.VisualState.xml
TestResult.xml
nunit-*.xml

publish/
__pycache__/
*.pyc
relay_server/*.pem
relay_server/*.key
relay_server/*.log

# Complete upstream corpus is a local, reproducible test input.
testdata/65816-full/

/testdata/spc700-full/
/testdata/local-firmware/

# One licensed external PPU test fixture (hash/license pinned).
!/testdata/ppu-external/vram-mid-scanline-test.sfc
